# Основной домен. Используется в canonical, Open Graph, robots.txt и sitemap.xml
NEXT_PUBLIC_SITE_URL=https://industriapostavok.ru

# Публичный товарный каталог. По умолчанию система закрывается безопасно.
# Производители управляются независимо и остаются публичными.
PRODUCT_CATALOG_PUBLIC_ENABLED=false

# Получатель заявок
REQUEST_TO_EMAIL=sales@industriapostavok.ru

# Домен отправителя должен быть подтверждён в Resend
REQUEST_FROM_EMAIL=Заявки сайта <requests@industriapostavok.ru>
RESEND_API_KEY=

# Код подтверждения из Яндекс Вебмастера
YANDEX_WEBMASTER_VERIFICATION=

# Административная панель /admin
# Используйте длинные уникальные значения и храните их только в окружении хостинга.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Fine-grained GitHub token: доступ только к этому репозиторию, Contents: Read and write.
GITHUB_CONTENT_TOKEN=
ADMIN_GITHUB_REPO=yanianya/industria-postavok
ADMIN_GITHUB_BRANCH=main
