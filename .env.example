# Canonical base used by metadata, Open Graph, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=https://ventroviaglobal.com
VENTROVIA_INTERNATIONAL_SITE_ENABLED=true

# The Russian catalogue is an independent archive and is excluded by default.
# Both flags are required only in a separate, deliberately restored archive runtime.
RUSSIAN_CATALOG_ARCHIVE_RUNTIME_ENABLED=false
PRODUCT_CATALOG_PUBLIC_ENABLED=false

# RFQ delivery. Verify the domain and mailbox before enabling production delivery.
REQUEST_TO_EMAIL=sales@ventroviaglobal.com
REQUEST_FROM_EMAIL=Ventrovia RFQ <requests@ventroviaglobal.com>
RESEND_API_KEY=

# Private administration surface.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional content storage. Keep the token server-side and tightly scoped.
GITHUB_CONTENT_TOKEN=
ADMIN_GITHUB_REPO=
ADMIN_GITHUB_BRANCH=main
