{
  "name": "industria-postavok-catalog",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build:timeweb": "next build",
    "start:timeweb": "next start -p ${PORT:-3000}",
    "quality:catalog": "node scripts/generate-catalog-quality.mjs && node scripts/generate-catalog-search-routing.mjs && node scripts/audit-catalog-integrity.mjs",
    "audit:catalog": "node scripts/generate-catalog-quality.mjs --check && node scripts/generate-catalog-search-routing.mjs --check && node scripts/audit-catalog-integrity.mjs --check",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
