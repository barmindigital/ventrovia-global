{
  "name": "ventrovia-global",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "node scripts/generate-international-manufacturer-directory.mjs --check && node scripts/generate-international-brand-knowledge.mjs --check && node scripts/generate-brand-operations.mjs --check",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "prebuild:timeweb": "npm run prebuild",
    "build:timeweb": "next build",
    "start:timeweb": "next start -p ${PORT:-3000}",
    "audit:bundle": "node scripts/audit-public-bundle.mjs",
    "audit:visual": "node scripts/audit-ventrovia-blue-regression.mjs",
    "audit:international": "node scripts/audit-international-runtime.mjs",
    "audit:infrastructure": "node scripts/audit-infrastructure-cutover.mjs",
    "audit:prelaunch": "node scripts/audit-prelaunch-production.mjs",
    "brands:international": "node --experimental-strip-types scripts/generate-international-brand-knowledge.mjs",
    "audit:brands:international": "node --experimental-strip-types scripts/generate-international-brand-knowledge.mjs --check",
    "brands:directory": "node scripts/generate-international-manufacturer-directory.mjs",
    "brands:operations": "node scripts/generate-brand-operations.mjs",
    "brands:master": "node scripts/generate-brand-master.mjs",
    "brands:logos:official": "node scripts/discover-official-site-logos.mjs",
    "brands:logos:official:download": "node scripts/download-official-site-logo-candidates.mjs",
    "brands:logos:official:import": "node scripts/import-reviewed-official-site-logos.mjs",
    "brands:logos:audit": "node --experimental-strip-types scripts/update-logo-audit.mjs",
    "audit:brands:master": "node scripts/generate-brand-master.mjs --check && node scripts/test-brand-master-portability.mjs brand-master --data-only",
    "package:brands:master": "node scripts/package-brand-master.mjs",
    "audit:brands": "node scripts/generate-brand-operations.mjs --check && node scripts/audit-international-runtime.mjs",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "pnpm run lint && pnpm run typecheck && pnpm test && pnpm audit:visual && pnpm audit:international && pnpm audit:infrastructure && pnpm audit:bundle && pnpm audit:brands:master"
  },
  "dependencies": {
    "@fontsource-variable/onest": "^5.3.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
